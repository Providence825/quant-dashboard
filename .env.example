# ===== 复制本文件为 .env 后按需修改 =====
# cp .env.example .env   (Windows: copy .env.example .env)

# --- 服务监听 ---
# 本机使用填 127.0.0.1；需要局域网/手机访问才填 0.0.0.0
# 警告：本项目无登录鉴权，切勿将 0.0.0.0 直接暴露到公网
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Flask 会话密钥，开源部署请改成随机字符串
FLASK_SECRET_KEY=change-me-to-a-random-string

# 只读模式：true 时禁止一切写操作（下单/导入/复盘），且不启动调度器
# 用于对外分享的只读实例
READONLY=false

# --- 模拟盘 / 回测参数 ---
INITIAL_CAPITAL=1000000    # 初始资金
COMMISSION_RATE=0.00025    # 佣金费率
STAMP_TAX_RATE=0.001       # 印花税（卖出）
STOP_LOSS_PCT=0.08         # 止损比例
TAKE_PROFIT_PCT=0.15       # 止盈比例
TRAILING_STOP_PCT=0.05     # 移动止损回撤
MAX_HOLD_DAYS=10           # 最大持有天数
MAX_POSITION_PCT=0.20      # 单票最大仓位
MAX_TOTAL_POSITION=0.80    # 总仓位上限
