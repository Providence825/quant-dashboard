# 守投者量化系统 - 环境变量配置模板
# 复制此文件为 .env 并填写真实值

# Flask 配置
FLASK_SECRET_KEY=your-random-secret-key-here-use-python-secrets-token-hex
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# DeepSeek AI 配置（必填）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# 部署模式
# READONLY=true 表示只读模式（公网分享用）
# HTD_ONLY=true 表示仅开放首投守护者服务
READONLY=false
HTD_ONLY=false

# 数据库路径（可选，默认为 data/quant.db）
# DATABASE_PATH=data/quant.db

# 日志级别（可选，默认 INFO）
# LOG_LEVEL=INFO
